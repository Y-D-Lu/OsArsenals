<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFDFDFDF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/overview_cpu_info_layout"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="8dp"
                android:background="#FFEFEFEF"
                android:orientation="horizontal">

            </LinearLayout>

            <LinearLayout
                android:id="@+id/overview_gpu_battery_info_layout"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@+id/overview_cpu_info_layout"
                android:layout_marginTop="8dp"
                android:background="#FFEFEFEF"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/overview_gpu_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center">

                        <cn.arsenals.osarsenals.views.PercentageCircleView
                            android:id="@+id/overview_gpu_info_cycle_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/overview_gpu_info_textview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="GPU" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/overview_gpu_info_inner_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/overview_gpu_info_freq_textview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/overview_gpu_info_utilization_textview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/overview_battery_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center">

                        <cn.arsenals.osarsenals.views.PercentageCircleView
                            android:id="@+id/overview_battery_info_cycle_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/overview_battery_info_textview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="BATTERY" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/overview_battery_info_inner_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/overview_battery_info_inner_textview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/overview_memory_info_layout"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@+id/overview_gpu_battery_info_layout"
                android:layout_marginTop="8dp"
                android:background="#FFEFEFEF"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center">

                    <cn.arsenals.osarsenals.views.PercentageCircleView
                        android:id="@+id/overview_memory_info_cycle_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/overview_memory_info_textview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="MEMORY" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/overview_memory_info_inner_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/overview_memory_info_physical_textview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/overview_memory_info_swap_textview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/overview_misc_info_layout"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@+id/overview_memory_info_layout"
                android:layout_marginTop="8dp"
                android:background="#FFEFEFEF"
                android:orientation="horizontal">

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>